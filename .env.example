# Application
APP_NAME=Doitall
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

# API
API_HOST=127.0.0.1
API_PORT=8000

# Optional. When set, POST /v1/chat and POST /v1/knowledge/ingest require
# either Authorization: Bearer <key> or X-API-Key: <key>.
API_KEY=

# CORS allowed origins. Default permits common localhost dev ports.
# In production set this to your actual frontend origin(s):
# CORS_ORIGINS=["https://app.example.com"]
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://localhost:5173"]

# Seconds of idle time before an in-memory chat session is evicted (default 1 h).
SESSION_TTL_SECONDS=3600


# Database
DATABASE_URL=sqlite:///storage/doitall.db

# Logging
LOG_LEVEL=INFO

# Memory / Knowledge vector storage
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
EMBEDDING_MODEL=text-embedding-3-large

# AI provider selection
DEFAULT_PROVIDER=gemini

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini/gemini-2.5-flash

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=anthropic/claude-3-5-sonnet-20241022

# Groq
GROQ_API_KEY=
GROQ_MODEL=groq/llama-3.3-70b-versatile

# NVIDIA
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/anthropic/claude-3.5-sonnet

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=ollama/llama3.2

# Keep false unless you intentionally want LLM tool calls to write/delete files.
ENABLE_FILESYSTEM_WRITE_TOOLS=false
